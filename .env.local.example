# ─── Solana RPC ──────────────────────────────────────────────────────────────
# Server-side RPC (used to build + verify transactions)
SOLANA_RPC_URL=https://rpc.solanatracker.io/public

# Client-side RPC (used by wallet adapter in the browser)
NEXT_PUBLIC_SOLANA_RPC_URL=https://rpc.solanatracker.io/public

# ─── Agent Token ─────────────────────────────────────────────────────────────
# The pump.fun token mint address for your tokenized agent
# Replace with your real mint address before deploying!
AGENT_TOKEN_MINT_ADDRESS=So11111111111111111111111111111111111111112

# ─── Payment Currency ────────────────────────────────────────────────────────
# SOL (wrapped): So11111111111111111111111111111111111111112
# USDC:          EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
CURRENCY_MINT=So11111111111111111111111111111111111111112


# ─── Price ───────────────────────────────────────────────────────────────────
# Amount in smallest unit: SOL uses 9 decimals (100000000 = 0.1 SOL)
PRICE_AMOUNT=100000000


# ─── Robinhood Chain Mindshare Dashboard (/mindshare) ─────────────────────────
# Rettiwt-api session key for reading X/Twitter data. Generate one with a
# dedicated (non-primary) X account:
#   npx rettiwt-api auth login -e <email> -u <username> -p <password>
# The command prints a long API key string — paste it below.
RETTIWT_API_KEY=

# Optional overrides — defaults live in src/data/kols.json
# MINDSHARE_CHAIN_NAME=Robinhood Chain
# MINDSHARE_KEYWORDS=Robinhood Chain,RobinhoodChain,$RHC
MINDSHARE_WINDOW_DAYS=7
MINDSHARE_REFRESH_MINUTES=5
MINDSHARE_BATCH_SIZE=15
MINDSHARE_MAX_PAGES=3
MINDSHARE_REQUEST_DELAY_MS=1500

# Optional: where the on-disk tweet cache is written (defaults to ./data)
# MINDSHARE_DATA_DIR=/var/data/mindshare

# Optional: require this bearer token on POST/GET /api/mindshare/refresh, for
# use with an external cron (Vercel Cron, GitHub Actions) on serverless
# deployments where the in-process scheduler doesn't persist between requests.
# MINDSHARE_REFRESH_SECRET=
